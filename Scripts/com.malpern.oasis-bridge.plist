<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.malpern.oasis-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>__OASIS_BRIDGE_EXECUTABLE__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__OASIS_BRIDGE_LOG__</string>
    <key>StandardErrorPath</key>
    <string>__OASIS_BRIDGE_LOG__</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
